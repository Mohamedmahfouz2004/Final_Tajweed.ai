# ─── OpenRouter (tajweed explanation LLM) ───
# Used by POST /api/explain on the model server to generate the post-recitation
# explanation report. Copy this file to `muaalem/.env` and fill in the key.
#
#   Windows PowerShell:  copy muaalem\.env.example muaalem\.env
#   macOS/Linux:         cp muaalem/.env.example muaalem/.env
#
# If OPENROUTER_API_KEY is empty, /api/explain still works but returns the static
# Arabic knowledge base instead of AI-personalised text (no AI).
#
# Free model slugs rotate and rate-limit — if explanations are always "static",
# pick a currently-available ":free" slug from https://openrouter.ai/api/v1/models
# or use a paid key.

OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_THE_TEAM_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Tried in order if the primary 404s/429s. Spread across providers (nvidia, meta,
# qwen, google) so a single provider being throttled can't force the static fallback.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free,google/gemma-4-31b-it:free,openai/gpt-oss-20b:free

# Bound the explanation call so the report never hangs (seconds).
OPENROUTER_TIMEOUT=18
OPENROUTER_TOTAL_BUDGET=35
